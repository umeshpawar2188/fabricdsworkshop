{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "hubName": {
      "type": "string",
      "defaultValue": "[concat('aifhub', take(newGuid(), 5))]",
      "metadata": {
        "description": "Name for the Azure AI Foundry Hub resource."
      }
    },
    "projectName": {
      "type": "string",
      "defaultValue": "[concat('aifproject', take(newGuid(), 5))]",
      "metadata": {
        "description": "Name for the Azure AI Foundry Project resource."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "[concat('aifst', take(newGuid(), 5))]",
      "metadata": {
        "description": "Storage account used by the AI Foundry Hub."
      }
    },
    "keyVaultName": {
      "type": "string",
      "defaultValue": "[concat('aifkv', take(newGuid(), 5))]",
      "metadata": {
        "description": "Key Vault used by the AI Foundry Hub."
      }
    },
    "openAiServiceName": {
      "type": "string",
      "metadata": {
        "description": "Name of an existing Azure OpenAI resource to connect to the Hub."
      }
    },
    "openAiResourceGroup": {
      "type": "string",
      "defaultValue": "[resourceGroup().name]",
      "metadata": {
        "description": "Resource group of the existing Azure OpenAI resource."
      }
    }
  },
  "variables": {
    "storageAccountId": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
    "keyVaultId": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
    "openAiResourceId": "[resourceId(parameters('openAiResourceGroup'), 'Microsoft.CognitiveServices/accounts', parameters('openAiServiceName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2021-04-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "kind": "StorageV2",
      "sku": {
        "name": "Standard_LRS"
      },
      "properties": {
        "isHnsEnabled": true,
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2021-04-01",
      "name": "[concat(parameters('storageAccountName'), '/default/photos')]",
      "dependsOn": [
        "[variables('storageAccountId')]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2022-07-01",
      "name": "[parameters('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "tenantId": "[subscription().tenantId]",
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "accessPolicies": []
      }
    },
    {
      "type": "Microsoft.MachineLearningServices/workspaces",
      "apiVersion": "2024-04-01",
      "name": "[parameters('hubName')]",
      "location": "[parameters('location')]",
      "kind": "Hub",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "friendlyName": "[parameters('hubName')]",
        "storageAccount": "[variables('storageAccountId')]",
        "keyVault": "[variables('keyVaultId')]",
        "hbiWorkspace": false
      },
      "dependsOn": [
        "[variables('storageAccountId')]",
        "[variables('keyVaultId')]"
      ]
    },
    {
      "type": "Microsoft.MachineLearningServices/workspaces/connections",
      "apiVersion": "2024-04-01",
      "name": "[concat(parameters('hubName'), '/openai-connection')]",
      "dependsOn": [
        "[resourceId('Microsoft.MachineLearningServices/workspaces', parameters('hubName'))]"
      ],
      "properties": {
        "category": "AzureOpenAI",
        "target": "[concat('https://', parameters('openAiServiceName'), '.openai.azure.com/')]",
        "authType": "ApiKey",
        "isSharedToAll": true,
        "credentials": {
          "key": "[listKeys(variables('openAiResourceId'), '2023-05-01').key1]"
        },
        "metadata": {
          "ApiVersion": "2024-02-01",
          "ApiType": "azure",
          "ResourceId": "[variables('openAiResourceId')]"
        }
      }
    },
    {
      "type": "Microsoft.MachineLearningServices/workspaces",
      "apiVersion": "2024-04-01",
      "name": "[parameters('projectName')]",
      "location": "[parameters('location')]",
      "kind": "Project",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "friendlyName": "[parameters('projectName')]",
        "hubResourceId": "[resourceId('Microsoft.MachineLearningServices/workspaces', parameters('hubName'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.MachineLearningServices/workspaces', parameters('hubName'))]"
      ]
    }
  ],
  "outputs": {
    "hubName": {
      "type": "string",
      "value": "[parameters('hubName')]"
    },
    "projectName": {
      "type": "string",
      "value": "[parameters('projectName')]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[parameters('storageAccountName')]"
    },
    "projectConnectionString": {
      "type": "string",
      "value": "[concat(parameters('location'), '.api.azureml.ms;', subscription().subscriptionId, ';', resourceGroup().name, ';', parameters('projectName'))]"
    }
  }
}
